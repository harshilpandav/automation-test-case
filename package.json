{
  "name": "sample-project",
  "version": "1.0.0",
  "description": "Playwright sample project with TestDino real-time reporting",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testdino/playwright": "^2.7.1",
    "@types/node": "^26.6.1",
    "dotenv": "^18.0.0",
    "typescript": "^7.0.2"
  }
}
